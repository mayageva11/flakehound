{
  "name": "flakehound",
  "version": "0.3.1",
  "description": "Root-cause analysis for flaky tests — clusters failures by underlying cause and separates flaky tests from hard regressions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayageva11/flakehound.git"
  },
  "homepage": "https://mayageva11.github.io/flakehound/",
  "bugs": {
    "url": "https://github.com/mayageva11/flakehound/issues"
  },
  "bin": {
    "flakehound": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('node:fs').copyFileSync('docs/index.html', 'dist/dashboard.html')\"",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "flaky-tests",
    "junit",
    "ci",
    "test-analysis",
    "clustering"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@octokit/rest": "^22.0.1",
    "commander": "^13.1.0",
    "fast-xml-parser": "^5.2.0",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.13",
    "ts-morph": "^28.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
